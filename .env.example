# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma Database Connection
# When running via Docker Compose: postgresql://postgres:password@localhost:5432/intelligent-voicemail
DATABASE_URL="postgresql://postgres:password@localhost:5432/intelligent-voicemail"

# Google Gemini API Key (used for multimodal audio transcription & clinical triage extraction)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Vercel Blob Storage Token (used for persistent voicemail audio storage)
# Obtain via Vercel Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
